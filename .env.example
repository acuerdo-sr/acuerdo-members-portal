NOTION_TOKEN=secret_xxxxxxxxxxxx
SITE_URL=https://acuerdo-sr.github.io/acuerdo-members-portal

# MyKomon/PSRからトップページのお知らせを更新する場合に使います。
# 実際のID/PASSは .env にだけ記入してください。
MYKOMON_ID=
MYKOMON_PASSWORD=
PSR_TOPICS_URL=https://www.psrn.jp/?transactionid=2e633e95368f07dd5080458f9cd82fd3e24bd47e
HOME_NOTICES_SINCE=2026-01-01
HOME_NOTICES_LIMIT=0
HOME_NOTICES_MAX_PAGES=20

# 新着お知らせが「顧問先向けの労務ニュースとして適切か」をAIで判定します。
# 未設定ならAI判定はスキップされ、これまで通りURL除外ルールだけで動きます。
# キーの取得: https://aistudio.google.com/apikey （Flash系は無料枠あり）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
